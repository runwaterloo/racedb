{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": [
    "docker",
    "github-actions",
    "docker-compose",
    "helm-values",
    "pip_requirements",
    "pre-commit"
  ],
  "timezone": "America/Toronto",
  "schedule": ["0 9 * * 2"],
  "packageRules": [
    {
      "matchManagers": [
        "docker",
        "github-actions",
        "docker-compose",
        "helm-values",
        "pip_requirements",
        "pre-commit"
      ],
      "groupName": "monthly dependency update",
      "groupSlug": "monthly-dependency-update",
      "commitMessagePrefix": "chore(deps):",
      "commitMessageAction": "update",
      "prTitle": "chore(deps): monthly dependency update"
    }
  ]
}
