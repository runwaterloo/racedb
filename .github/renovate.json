{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": [
    "dockerfile",
    "github-actions",
    "docker-compose",
    "helm-values",
    "pip_requirements",
    "pre-commit"
  ],
  "timezone": "America/Toronto",
  "schedule": ["* 9-10 1-7 * 2"],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "matchManagers": [
        "dockerfile",
        "github-actions",
        "docker-compose",
        "helm-values",
        "pip_requirements",
        "pre-commit"
      ],
      "matchPackagePatterns": ["^(?i)(python|django)$"],
      "groupName": "monthly dependency update",
      "groupSlug": "monthly-dependency-update",
      "commitMessagePrefix": "chore(deps):"
    },
    {
      "matchUpdateTypes": ["patch", "digest"],
      "matchManagers": ["pip_requirements", "dockerfile"],
      "matchPackagePatterns": ["^(?i)(python|django)$"],
      "groupName": "monthly dependency update",
      "groupSlug": "monthly-dependency-update",
      "commitMessagePrefix": "chore(deps):"
    }
  ]
}
