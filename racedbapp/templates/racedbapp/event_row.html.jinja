{# Jinja2 row partial: the event results <tr>. Rendered per row by
   view_event with a cached Environment. Jinja compiles to Python, so the
   ~30 lookups per row here cost ~10x less than DTL variable resolution.
   Kept in a partial so escaping stays automatic and HTML stays in markup. #}
<tr>
  <td class="text-center">{{ r.place_display }}</td>
  <td class="text-center">{{ r.bib }}</td>
  <td class="text-left">
    {%- if r.member -%}
      <a href="/member/{{ r.member.slug }}/">{{ r.name }}</a>
    {%- else -%}
      {{ r.name }}
    {%- endif -%}
    {%- if r.gender_place == 1 -%}
      <i class="fas fa-trophy fa-icon-1st-oa" title="1st Overall ({{ r.gender }})"></i>
    {%- elif r.gender_place == 2 -%}
      <i class="fas fa-medal fa-icon-2nd-oa" title="2nd Overall ({{ r.gender }})"></i>
    {%- elif r.gender_place == 3 -%}
      <i class="fas fa-medal fa-icon-3rd-oa" title="3rd Overall ({{ r.gender }})"></i>
    {%- endif -%}
    {%- if r.masters_place == 1 -%}
      <i class="fas fa-medal fa-icon-1st-master" title="1st Master ({{ r.gender }})"></i>
    {%- endif -%}
    {%- if r.isrwpb and r.member -%}
      <i class="fas fa-stopwatch fa-icon-pb" title="RW PB for the {{ event_distance_name }}"></i>
    {%- endif -%}
    {%- if r.isrwfirst -%}
      <i class="fa-solid fa-hand-wave fa-icon-firstrace" title="Welcome new RW member!"></i>
    {%- endif -%}
    {%- if r.relay_team -%}<i class="fas fa-users" title="{{ r.relay_team }}"></i>{%- endif -%}
  </td>
  {%- if show_photos -%}
    {%- if r.hasphotos -%}
      <td class="text-center"><a href="https://www.flickr.com/photos/runwaterloo/tags/{{ flickrsearchstr }},{{ r.bib }}" target="_blank"><i class="fas fa-camera"></i></a></td>
    {%- else -%}
      <td></td>
    {%- endif -%}
  {%- endif -%}
  {%- if show_youtube -%}
    {%- if r.youtube_url -%}
      <td class="text-center"><a href="{{ r.youtube_url }}" target="_blank"><i class="fas fa-video"></i></a></td>
    {%- else -%}
      <td></td>
    {%- endif -%}
  {%- endif -%}
  <td class="text-center">{{ r.time_display }}</td>
  {%- if hill_dict -%}<td class="text-center">{{ r.prime }}</td>{%- endif -%}
  <td class="text-center">{{ r.gender }}</td>
  <td class="text-center">{{ r.gender_place }}</td>
  {%- if show_category -%}
    <td class="text-center">{{ r.category }}</td>
    <td class="text-center">{{ r.category_place }}</td>
  {%- endif -%}
  {%- if show_age -%}<td class="text-center">{{ r.age }}</td>{%- endif -%}
  {%- if hasdivision -%}
    {%- if r.division != "Guest" -%}
      <td class="text-left"><a href="/endurrun/{{ r.division|lower }}/?year={{ event_date_year }}">{{ r.division }}</a></td>
    {%- else -%}
      <td class="text-left">{{ r.division }}</td>
    {%- endif -%}
  {%- endif -%}
  <td class="text-center">{{ r.pace }}</td>
  {%- if show_chip -%}<td class="text-center">{{ r.chip_display }}</td>{%- endif -%}
  <td class="text-left">{{ r.city }}</td>
  {%- for cell in r.split_cells -%}<td class="text-center">{{ cell }}</td>{%- endfor -%}
</tr>
